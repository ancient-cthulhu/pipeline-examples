// =============================================================================
// CI - Veracode (Jenkins, agente Linux)
// =============================================================================
// Tipo de job: Multibranch Pipeline (provee BRANCH_NAME, CHANGE_ID, CHANGE_TARGET)
// Probado con: https://github.com/veracode/verademo (pom en app/pom.xml)
//
// Credenciales de Jenkins (Manage Jenkins > Credentials), tipo "Secret text":
//   veracode-api-id      Veracode API ID
//   veracode-api-key     Veracode API Key
//   srcclr-api-token     Token de SCA basado en agente (opcional, SCA se omite si falta)
//
// Variables de entorno opcionales del job/carpeta:
//   VERACODE_APP_NAME    Nombre del perfil de aplicacion (por defecto: ruta del job multibranch sin la rama)
//   MAVEN_POM_PATH       Ruta del pom de Maven       (por defecto: app/pom.xml)
//   VERACODE_SOURCE_DIR  Directorio para autopackager (por defecto: app)
//
// Seleccion de escaneo:
//   push a la rama por defecto       -> Policy Scan (todos los artefactos, una carga)
//   push a feature/*                 -> Pipeline Scan (falla con cualquier hallazgo)
//   change request a rama por defecto -> Pipeline Scan (gate de politica)
//   todos los anteriores             -> SCA basado en agente (no bloqueante)
//
// Si tu rama por defecto no es "main", cambia DEFAULT_BRANCH abajo.
// =============================================================================

pipeline {
    agent { label 'linux' }

    options {
        timestamps()
        timeout(time: 2, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    environment {
        DEFAULT_BRANCH   = 'main'
        PR_GATE_POLICY   = 'Veracode Recommended Very High'
        VERACODE_API_ID  = credentials('veracode-api-id')
        VERACODE_API_KEY = credentials('veracode-api-key')
    }

    stages {
        // ---------------------------------------------------------------------
        // BUILD: build de Maven antes del autopackager (estructura de verademo)
        // ---------------------------------------------------------------------
        stage('Build (Maven)') {
            steps {
                sh '''
                    set -e
                    echo "Branch: ${BRANCH_NAME:-n/a}  Change: ${CHANGE_ID:-none}  Target: ${CHANGE_TARGET:-n/a}"
                    mvn -B -f "${MAVEN_POM_PATH:-app/pom.xml}" clean package -DskipTests
                '''
            }
        }

        // ---------------------------------------------------------------------
        // PACKAGE: Autopackager de Veracode CLI
        // ---------------------------------------------------------------------
        stage('Empaquetar Artefactos') {
            steps {
                script {
                    // En multibranch JOB_NAME es "<carpeta>/<repo>/<rama>". Se quita el
                    // segmento de rama para que todas las ramas usen el mismo perfil.
                    def jobPath = env.JOB_NAME
                    if (env.BRANCH_NAME && jobPath.contains('/')) {
                        jobPath = jobPath.substring(0, jobPath.lastIndexOf('/'))
                    }
                    env.APP_NAME = env.VERACODE_APP_NAME?.trim() ?: jobPath
                    echo "Perfil de Aplicacion Veracode: ${env.APP_NAME}"
                }
                sh '''
                    set -e
                    curl -fsS https://tools.veracode.com/veracode-cli/install | sh
                    ./veracode version

                    mkdir -p verascan
                    ./veracode package --source "${VERACODE_SOURCE_DIR:-app}" --output verascan --trust
                    ls -lhR verascan

                    find verascan -type f \\( -name "*.war" -o -name "*.jar" -o -name "*.zip" \\) > artifact_list.txt
                    if [ ! -s artifact_list.txt ]; then
                        echo "ERROR: No se encontraron artefactos empaquetados"
                        exit 1
                    fi
                    echo "Artefactos encontrados ($(wc -l < artifact_list.txt)):"
                    cat artifact_list.txt
                '''
            }
            post {
                success {
                    stash name: 'verascan', includes: 'verascan/**,artifact_list.txt'
                }
            }
        }

        // ---------------------------------------------------------------------
        // ESCANEOS DE SEGURIDAD (en paralelo)
        // ---------------------------------------------------------------------
        stage('Escaneos Veracode') {
            parallel {
                // -------------------------------------------------------------
                // SCA: Agent-based SCA (non-blocking)
                // -------------------------------------------------------------
                stage('SCA Basado en Agente') {
                    steps {
                        script {
                            try {
                                withCredentials([string(credentialsId: 'srcclr-api-token', variable: 'SRCCLR_API_TOKEN')]) {
                                    // APP_NAME viene del stage de empaquetado, el mismo valor que usa el policy scan
                                    // --appname se autentica con la Plataforma via HMAC, que el agente
                                    // lee exactamente desde estos dos nombres de variable
                                    sh '''
                                        export VERACODE_API_KEY_ID="$VERACODE_API_ID"
                                        export VERACODE_API_KEY_SECRET="$VERACODE_API_KEY"
                                        curl -sSL https://sca-downloads.veracode.com/ci.sh | sh -s -- \\
                                            scan --recursive --update-advisor --appname="$APP_NAME" || echo "Escaneo SCA completado"
                                    '''
                                }
                            } catch (org.jenkinsci.plugins.credentialsbinding.impl.CredentialNotFoundException e) {
                                echo "Credencial 'srcclr-api-token' no configurada. Se omite SCA."
                            }
                        }
                    }
                }

                // -------------------------------------------------------------
                // PIPELINE SCAN: push a feature/* (falla con cualquier hallazgo) y
                // change request a la rama por defecto (gate de politica)
                // -------------------------------------------------------------
                stage('Pipeline Scan') {
                    when {
                        anyOf {
                            expression { !env.CHANGE_ID && env.BRANCH_NAME?.startsWith('feature/') }
                            expression { env.CHANGE_ID && env.CHANGE_TARGET == env.DEFAULT_BRANCH }
                        }
                    }
                    steps {
                        dir('pipeline-scan') {
                            unstash 'verascan'
                            sh '''
                                set -e
                                curl -fsSO https://downloads.veracode.com/securityscan/pipeline-scan-LATEST.zip
                                unzip -o pipeline-scan-LATEST.zip pipeline-scan.jar

                                # Change request: evalua los hallazgos contra una politica de Veracode
                                # feature:        sin criterio de fallo, cada hallazgo cuenta
                                if [ -n "$CHANGE_ID" ]; then
                                    GATE_POLICY="$PR_GATE_POLICY"
                                    echo "Gate: politica '$GATE_POLICY'"
                                else
                                    GATE_POLICY=""
                                    echo "Gate: falla con cualquier hallazgo"
                                fi

                                mkdir -p scan_results
                                FAILED=0
                                FAILED_ARTIFACTS=""

                                while IFS= read -r artifact; do
                                    NAME=$(basename "$artifact")
                                    echo "=========================================="
                                    echo "Escaneando: $NAME"
                                    echo "=========================================="

                                    set +e
                                    if [ -n "$GATE_POLICY" ]; then
                                        java -jar pipeline-scan.jar -f "$artifact" \\
                                            -vid "$VERACODE_API_ID" -vkey "$VERACODE_API_KEY" \\
                                            --issue_details true --policy_name "$GATE_POLICY"
                                    else
                                        java -jar pipeline-scan.jar -f "$artifact" \\
                                            -vid "$VERACODE_API_ID" -vkey "$VERACODE_API_KEY" \\
                                            --issue_details true
                                    fi
                                    RC=$?
                                    set -e

                                    # 0 = aprobado, 1-200 = cantidad de hallazgos, 253-255 = error o timeout
                                    if [ "$RC" -ge 253 ]; then
                                        echo "ERROR: Error de escaneo en $NAME (salida $RC)"
                                        FAILED=1; FAILED_ARTIFACTS="$FAILED_ARTIFACTS $NAME"
                                    elif [ "$RC" -ne 0 ]; then
                                        echo "ERROR: $RC hallazgo(s) fallaron el gate en $NAME"
                                        FAILED=1; FAILED_ARTIFACTS="$FAILED_ARTIFACTS $NAME"
                                    fi

                                    if [ -f results.json ]; then
                                        mv results.json "scan_results/${NAME}_results.json"
                                    fi
                                done < artifact_list.txt

                                if [ "$FAILED" -eq 1 ]; then
                                    echo "ERROR: Pipeline Scan fallo para:$FAILED_ARTIFACTS"
                                fi
                                exit "$FAILED"
                            '''
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'pipeline-scan/scan_results/**', allowEmptyArchive: true
                        }
                    }
                }

                // -------------------------------------------------------------
                // POLICY SCAN: push a la rama por defecto
                // -------------------------------------------------------------
                stage('Policy Scan') {
                    when {
                        expression { !env.CHANGE_ID && env.BRANCH_NAME == env.DEFAULT_BRANCH }
                    }
                    steps {
                        dir('policy-scan') {
                            unstash 'verascan'
                            sh '''
                                set -e
                                BASE=https://repo1.maven.org/maven2/com/veracode/vosp/api/wrappers/vosp-api-wrappers-java
                                curl -fsS "$BASE/maven-metadata.xml" -o maven-metadata.xml
                                VERSION=$(grep -oPm1 "(?<=<latest>)[^<]+" maven-metadata.xml)
                                if [ -z "$VERSION" ]; then
                                    echo "ERROR: No se pudo resolver la version del API Wrapper"
                                    exit 1
                                fi
                                echo "Version del API Wrapper: $VERSION"
                                curl -fsSL "$BASE/${VERSION}/vosp-api-wrappers-java-${VERSION}-dist.zip" -o dist.zip
                                unzip -o dist.zip -d .veracode
                                JAR=$(find .veracode -type f -name "VeracodeJavaAPI*.jar" | head -n1)
                                if [ -z "$JAR" ]; then
                                    echo "ERROR: No se encontro VeracodeJavaAPI.jar"
                                    exit 1
                                fi

                                java -jar "$JAR" \\
                                    -vid "$VERACODE_API_ID" \\
                                    -vkey "$VERACODE_API_KEY" \\
                                    -action UploadAndScan \\
                                    -appname "$APP_NAME" \\
                                    -createprofile true \\
                                    -autoscan true \\
                                    -filepath verascan \\
                                    -version "${BRANCH_NAME}-${BUILD_NUMBER}"
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}
