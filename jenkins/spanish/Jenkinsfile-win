// =============================================================================
// CI - Veracode (Jenkins, agente Windows, PowerShell)
// =============================================================================
// Tipo de job: Multibranch Pipeline (provee BRANCH_NAME, CHANGE_ID, CHANGE_TARGET)
// Probado con: https://github.com/veracode/verademo (pom en app/pom.xml)
//
// Credenciales de Jenkins (Manage Jenkins > Credentials), tipo "Secret text":
//   veracode-api-id      Veracode API ID
//   veracode-api-key     Veracode API Key
//   srcclr-api-token     Token de SCA basado en agente (opcional, SCA se omite si falta)
//
// Variables de entorno opcionales del job/carpeta:
//   VERACODE_APP_NAME    Nombre del perfil de aplicacion (por defecto: ruta del job multibranch sin la rama)
//   MAVEN_POM_PATH       Ruta del pom de Maven       (por defecto: app/pom.xml)
//   VERACODE_SOURCE_DIR  Directorio para autopackager (por defecto: app)
//
// Seleccion de escaneo:
//   push a la rama por defecto       -> Policy Scan (todos los artefactos, una carga)
//   push a feature/*                 -> Pipeline Scan (falla con cualquier hallazgo)
//   change request a rama por defecto -> Pipeline Scan (gate de politica)
//   todos los anteriores             -> SCA basado en agente (no bloqueante)
//
// Requisitos del agente: Windows PowerShell 5.1+, Java 8+, Maven en el PATH.
// Si tu rama por defecto no es "main", cambia DEFAULT_BRANCH abajo.
// =============================================================================

pipeline {
    agent { label 'windows' }

    options {
        timestamps()
        timeout(time: 2, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    environment {
        DEFAULT_BRANCH   = 'main'
        PR_GATE_POLICY   = 'Veracode Recommended Very High'
        VERACODE_API_ID  = credentials('veracode-api-id')
        VERACODE_API_KEY = credentials('veracode-api-key')
    }

    stages {
        // ---------------------------------------------------------------------
        // BUILD: build de Maven antes del autopackager (estructura de verademo)
        // ---------------------------------------------------------------------
        stage('Build (Maven)') {
            steps {
                powershell '''
                    $ErrorActionPreference = "Stop"
                    Write-Host "Branch: $env:BRANCH_NAME  Change: $env:CHANGE_ID  Target: $env:CHANGE_TARGET"
                    $pom = if ($env:MAVEN_POM_PATH) { $env:MAVEN_POM_PATH } else { "app/pom.xml" }
                    mvn -B -f "$pom" clean package -DskipTests
                    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
                '''
            }
        }

        // ---------------------------------------------------------------------
        // PACKAGE: Autopackager de Veracode CLI
        // ---------------------------------------------------------------------
        stage('Empaquetar Artefactos') {
            steps {
                script {
                    // En multibranch JOB_NAME es "<carpeta>/<repo>/<rama>". Se quita el
                    // segmento de rama para que todas las ramas usen el mismo perfil.
                    def jobPath = env.JOB_NAME
                    if (env.BRANCH_NAME && jobPath.contains('/')) {
                        jobPath = jobPath.substring(0, jobPath.lastIndexOf('/'))
                    }
                    env.APP_NAME = env.VERACODE_APP_NAME?.trim() ?: jobPath
                    echo "Perfil de Aplicacion Veracode: ${env.APP_NAME}"
                }
                powershell '''
                    $ErrorActionPreference = "Stop"
                    $ProgressPreference = "SilentlyContinue"

                    Invoke-WebRequest -UseBasicParsing -Uri "https://tools.veracode.com/veracode-cli/install.ps1" -OutFile "install.ps1"
                    powershell -NoProfile -ExecutionPolicy Bypass -File ".\\install.ps1"

                    $veracode = Join-Path $env:USERPROFILE ".veracode-cli\\veracode.exe"
                    if (-not (Test-Path $veracode)) { $veracode = "veracode" }
                    & $veracode version

                    $sourceDir = if ($env:VERACODE_SOURCE_DIR) { $env:VERACODE_SOURCE_DIR } else { "app" }
                    New-Item -ItemType Directory -Force -Path verascan | Out-Null
                    & $veracode package --source "$sourceDir" --output verascan --trust
                    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

                    # Rutas relativas (.\\verascan\\...) para que la lista funcione tras unstash
                    $artifacts = Get-ChildItem -Path verascan -Recurse -File -Include *.war, *.jar, *.zip
                    if (-not $artifacts) {
                        Write-Host "ERROR: No se encontraron artefactos empaquetados"
                        exit 1
                    }
                    $artifacts | ForEach-Object { Resolve-Path -Relative $_.FullName } |
                        Set-Content -Path artifact_list.txt -Encoding ASCII

                    Write-Host "Artefactos encontrados ($(@($artifacts).Count)):"
                    Get-Content artifact_list.txt
                '''
            }
            post {
                success {
                    stash name: 'verascan', includes: 'verascan/**,artifact_list.txt'
                }
            }
        }

        // ---------------------------------------------------------------------
        // ESCANEOS DE SEGURIDAD (en paralelo)
        // ---------------------------------------------------------------------
        stage('Escaneos Veracode') {
            parallel {
                // -------------------------------------------------------------
                // SCA: SCA basado en agente via ci.ps1 (no bloqueante)
                // -------------------------------------------------------------
                stage('SCA Basado en Agente') {
                    steps {
                        script {
                            try {
                                withCredentials([string(credentialsId: 'srcclr-api-token', variable: 'SRCCLR_API_TOKEN')]) {
                                    // returnStatus mantiene SCA no bloqueante aunque ci.ps1 salga con error
                                    def rc = powershell(returnStatus: true, script: '''
                                        $script = (New-Object System.Net.WebClient).DownloadString("https://sca-downloads.veracode.com/ci.ps1")
                                        Invoke-Command -ScriptBlock ([scriptblock]::Create($script)) -ArgumentList @("scan", "--recursive", "--update-advisor")
                                    ''')
                                    echo "Escaneo SCA completado (salida ${rc})"
                                }
                            } catch (org.jenkinsci.plugins.credentialsbinding.impl.CredentialNotFoundException e) {
                                echo "Credencial 'srcclr-api-token' no configurada. Se omite SCA."
                            }
                        }
                    }
                }

                // -------------------------------------------------------------
                // PIPELINE SCAN: push a feature/* (falla con cualquier hallazgo) y
                // change request a la rama por defecto (gate de politica)
                // -------------------------------------------------------------
                stage('Pipeline Scan') {
                    when {
                        anyOf {
                            expression { !env.CHANGE_ID && env.BRANCH_NAME?.startsWith('feature/') }
                            expression { env.CHANGE_ID && env.CHANGE_TARGET == env.DEFAULT_BRANCH }
                        }
                    }
                    steps {
                        dir('pipeline-scan') {
                            unstash 'verascan'
                            powershell '''
                                $ErrorActionPreference = "Stop"
                                $ProgressPreference = "SilentlyContinue"

                                Invoke-WebRequest -UseBasicParsing -Uri "https://downloads.veracode.com/securityscan/pipeline-scan-LATEST.zip" -OutFile "pipeline-scan-LATEST.zip"
                                Expand-Archive -Path "pipeline-scan-LATEST.zip" -DestinationPath "pipeline-scan" -Force
                                $jar = Get-ChildItem -Path "pipeline-scan" -Recurse -Filter "pipeline-scan.jar" | Select-Object -First 1
                                if (-not $jar) { Write-Host "ERROR: No se encontro pipeline-scan.jar"; exit 1 }

                                # Change request: evalua los hallazgos contra una politica de Veracode
                                # feature:        sin criterio de fallo, cada hallazgo cuenta
                                $gateArgs = @()
                                if ($env:CHANGE_ID) {
                                    $gateArgs = @("--policy_name", $env:PR_GATE_POLICY)
                                    Write-Host "Gate: politica '$env:PR_GATE_POLICY'"
                                } else {
                                    Write-Host "Gate: falla con cualquier hallazgo"
                                }

                                New-Item -ItemType Directory -Force -Path scan_results | Out-Null
                                $failed = @()

                                foreach ($artifact in Get-Content artifact_list.txt) {
                                    if (-not $artifact) { continue }
                                    $name = Split-Path $artifact -Leaf
                                    Write-Host "=========================================="
                                    Write-Host "Escaneando: $name"
                                    Write-Host "=========================================="

                                    & java -jar $jar.FullName -f $artifact -vid $env:VERACODE_API_ID -vkey $env:VERACODE_API_KEY --issue_details true @gateArgs
                                    $rc = $LASTEXITCODE

                                    # 0 = aprobado, 1-200 = cantidad de hallazgos, 253-255 = error o timeout
                                    if ($rc -ge 253 -or $rc -lt 0) {
                                        Write-Host "ERROR: Error de escaneo en $name (salida $rc)"
                                        $failed += $name
                                    } elseif ($rc -ne 0) {
                                        Write-Host "ERROR: $rc hallazgo(s) fallaron el gate en $name"
                                        $failed += $name
                                    }

                                    if (Test-Path results.json) {
                                        Move-Item -Force results.json "scan_results\\$($name)_results.json"
                                    }
                                }

                                if ($failed.Count -gt 0) {
                                    Write-Host "ERROR: Pipeline Scan fallo para: $($failed -join ', ')"
                                    exit 1
                                }
                                exit 0
                            '''
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'pipeline-scan/scan_results/**', allowEmptyArchive: true
                        }
                    }
                }

                // -------------------------------------------------------------
                // POLICY SCAN: push a la rama por defecto
                // -------------------------------------------------------------
                stage('Policy Scan') {
                    when {
                        expression { !env.CHANGE_ID && env.BRANCH_NAME == env.DEFAULT_BRANCH }
                    }
                    steps {
                        dir('policy-scan') {
                            unstash 'verascan'
                            powershell '''
                                $ErrorActionPreference = "Stop"
                                $ProgressPreference = "SilentlyContinue"

                                $base = "https://repo1.maven.org/maven2/com/veracode/vosp/api/wrappers/vosp-api-wrappers-java"
                                [xml]$metadata = (Invoke-WebRequest -UseBasicParsing -Uri "$base/maven-metadata.xml").Content
                                $version = $metadata.metadata.versioning.latest
                                if (-not $version) { Write-Host "ERROR: No se pudo resolver la version del API Wrapper"; exit 1 }
                                Write-Host "Version del API Wrapper: $version"

                                Invoke-WebRequest -UseBasicParsing -Uri "$base/$version/vosp-api-wrappers-java-$version-dist.zip" -OutFile "dist.zip"
                                Expand-Archive -Path "dist.zip" -DestinationPath ".veracode" -Force
                                $jar = Get-ChildItem -Path ".veracode" -Recurse -Filter "VeracodeJavaAPI*.jar" | Select-Object -First 1
                                if (-not $jar) { Write-Host "ERROR: No se encontro VeracodeJavaAPI.jar"; exit 1 }

                                & java -jar $jar.FullName `
                                    -vid $env:VERACODE_API_ID `
                                    -vkey $env:VERACODE_API_KEY `
                                    -action UploadAndScan `
                                    -appname $env:APP_NAME `
                                    -createprofile true `
                                    -autoscan true `
                                    -filepath verascan `
                                    -version "$($env:BRANCH_NAME)-$($env:BUILD_NUMBER)"
                                exit $LASTEXITCODE
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}
