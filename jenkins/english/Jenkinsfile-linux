// =============================================================================
// CI - Veracode (Jenkins, Linux agent)
// =============================================================================
// Job type: Multibranch Pipeline (provides BRANCH_NAME, CHANGE_ID, CHANGE_TARGET)
// Tested against: https://github.com/veracode/verademo (pom at app/pom.xml)
//
// Jenkins credentials (Manage Jenkins > Credentials), kind "Secret text":
//   veracode-api-id      Veracode API ID
//   veracode-api-key     Veracode API Key
//   srcclr-api-token     Agent-based SCA token (optional, SCA skipped if missing)
//
// Optional job/folder environment variables:
//   VERACODE_APP_NAME    Application profile name (default: multibranch job path without branch)
//   MAVEN_POM_PATH       Maven pom path            (default: app/pom.xml)
//   VERACODE_SOURCE_DIR  Autopackager source dir   (default: app)
//
// Scan selection:
//   push to default branch          -> Policy Scan (all artifacts, one upload)
//   push to feature/*               -> Pipeline Scan (fails on any flaw)
//   change request to default branch -> Pipeline Scan (policy gate)
//   all of the above                -> Agent-based SCA (non-blocking)
//
// If your default branch is not "main", change DEFAULT_BRANCH below.
// =============================================================================

pipeline {
    agent { label 'linux' }

    options {
        timestamps()
        timeout(time: 2, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    environment {
        DEFAULT_BRANCH   = 'main'
        PR_GATE_POLICY   = 'Veracode Recommended Very High'
        VERACODE_API_ID  = credentials('veracode-api-id')
        VERACODE_API_KEY = credentials('veracode-api-key')
    }

    stages {
        // ---------------------------------------------------------------------
        // BUILD: Maven build before the autopackager (verademo layout)
        // ---------------------------------------------------------------------
        stage('Build (Maven)') {
            steps {
                sh '''
                    set -e
                    echo "Branch: ${BRANCH_NAME:-n/a}  Change: ${CHANGE_ID:-none}  Target: ${CHANGE_TARGET:-n/a}"
                    mvn -B -f "${MAVEN_POM_PATH:-app/pom.xml}" clean package -DskipTests
                '''
            }
        }

        // ---------------------------------------------------------------------
        // PACKAGE: Veracode CLI autopackager
        // ---------------------------------------------------------------------
        stage('Package Artifacts') {
            steps {
                script {
                    // Multibranch JOB_NAME is "<folder>/<repo>/<branch>". Drop the
                    // branch segment so every branch maps to the same profile.
                    def jobPath = env.JOB_NAME
                    if (env.BRANCH_NAME && jobPath.contains('/')) {
                        jobPath = jobPath.substring(0, jobPath.lastIndexOf('/'))
                    }
                    env.APP_NAME = env.VERACODE_APP_NAME?.trim() ?: jobPath
                    echo "Veracode Application Profile: ${env.APP_NAME}"
                }
                sh '''
                    set -e
                    curl -fsS https://tools.veracode.com/veracode-cli/install | sh
                    ./veracode version

                    mkdir -p verascan
                    ./veracode package --source "${VERACODE_SOURCE_DIR:-app}" --output verascan --trust
                    ls -lhR verascan

                    find verascan -type f \\( -name "*.war" -o -name "*.jar" -o -name "*.zip" \\) > artifact_list.txt
                    if [ ! -s artifact_list.txt ]; then
                        echo "ERROR: No packaged artifacts found"
                        exit 1
                    fi
                    echo "Artifacts found ($(wc -l < artifact_list.txt)):"
                    cat artifact_list.txt
                '''
            }
            post {
                success {
                    stash name: 'verascan', includes: 'verascan/**,artifact_list.txt'
                }
            }
        }

        // ---------------------------------------------------------------------
        // SECURITY SCANS (parallel)
        // ---------------------------------------------------------------------
        stage('Veracode Scans') {
            parallel {
                // -------------------------------------------------------------
                // SCA: Agent-based SCA (non-blocking)
                // -------------------------------------------------------------
                stage('Agent-Based SCA') {
                    steps {
                        script {
                            try {
                                withCredentials([string(credentialsId: 'srcclr-api-token', variable: 'SRCCLR_API_TOKEN')]) {
                                    // APP_NAME comes from the Package stage, same value the policy scan uses
                                    sh 'curl -sSL https://sca-downloads.veracode.com/ci.sh | sh -s -- scan --recursive --update-advisor --appname "$APP_NAME" || echo "SCA scan completed"'
                                }
                            } catch (org.jenkinsci.plugins.credentialsbinding.impl.CredentialNotFoundException e) {
                                echo "Credential 'srcclr-api-token' not configured. Skipping SCA."
                            }
                        }
                    }
                }

                // -------------------------------------------------------------
                // PIPELINE SCAN: feature/* push (any flaw fails) and
                // change request to default branch (policy gate)
                // -------------------------------------------------------------
                stage('Pipeline Scan') {
                    when {
                        anyOf {
                            expression { !env.CHANGE_ID && env.BRANCH_NAME?.startsWith('feature/') }
                            expression { env.CHANGE_ID && env.CHANGE_TARGET == env.DEFAULT_BRANCH }
                        }
                    }
                    steps {
                        dir('pipeline-scan') {
                            unstash 'verascan'
                            sh '''
                                set -e
                                curl -fsSO https://downloads.veracode.com/securityscan/pipeline-scan-LATEST.zip
                                unzip -o pipeline-scan-LATEST.zip pipeline-scan.jar

                                # Change request: evaluate findings against a Veracode policy
                                # feature:        no fail criteria, every flaw counts
                                if [ -n "$CHANGE_ID" ]; then
                                    GATE_POLICY="$PR_GATE_POLICY"
                                    echo "Gate: policy '$GATE_POLICY'"
                                else
                                    GATE_POLICY=""
                                    echo "Gate: fail on any flaw"
                                fi

                                mkdir -p scan_results
                                FAILED=0
                                FAILED_ARTIFACTS=""

                                while IFS= read -r artifact; do
                                    NAME=$(basename "$artifact")
                                    echo "=========================================="
                                    echo "Scanning: $NAME"
                                    echo "=========================================="

                                    set +e
                                    if [ -n "$GATE_POLICY" ]; then
                                        java -jar pipeline-scan.jar -f "$artifact" \\
                                            -vid "$VERACODE_API_ID" -vkey "$VERACODE_API_KEY" \\
                                            --issue_details true --policy_name "$GATE_POLICY"
                                    else
                                        java -jar pipeline-scan.jar -f "$artifact" \\
                                            -vid "$VERACODE_API_ID" -vkey "$VERACODE_API_KEY" \\
                                            --issue_details true
                                    fi
                                    RC=$?
                                    set -e

                                    # 0 = pass, 1-200 = flaw count, 253-255 = error or timeout
                                    if [ "$RC" -ge 253 ]; then
                                        echo "ERROR: Scan error for $NAME (exit $RC)"
                                        FAILED=1; FAILED_ARTIFACTS="$FAILED_ARTIFACTS $NAME"
                                    elif [ "$RC" -ne 0 ]; then
                                        echo "ERROR: $RC flaw(s) failed the gate for $NAME"
                                        FAILED=1; FAILED_ARTIFACTS="$FAILED_ARTIFACTS $NAME"
                                    fi

                                    if [ -f results.json ]; then
                                        mv results.json "scan_results/${NAME}_results.json"
                                    fi
                                done < artifact_list.txt

                                if [ "$FAILED" -eq 1 ]; then
                                    echo "ERROR: Pipeline Scan failed for:$FAILED_ARTIFACTS"
                                fi
                                exit "$FAILED"
                            '''
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'pipeline-scan/scan_results/**', allowEmptyArchive: true
                        }
                    }
                }

                // -------------------------------------------------------------
                // POLICY SCAN: push to default branch
                // -------------------------------------------------------------
                stage('Policy Scan') {
                    when {
                        expression { !env.CHANGE_ID && env.BRANCH_NAME == env.DEFAULT_BRANCH }
                    }
                    steps {
                        dir('policy-scan') {
                            unstash 'verascan'
                            sh '''
                                set -e
                                BASE=https://repo1.maven.org/maven2/com/veracode/vosp/api/wrappers/vosp-api-wrappers-java
                                curl -fsS "$BASE/maven-metadata.xml" -o maven-metadata.xml
                                VERSION=$(grep -oPm1 "(?<=<latest>)[^<]+" maven-metadata.xml)
                                if [ -z "$VERSION" ]; then
                                    echo "ERROR: Failed to resolve API Wrapper version"
                                    exit 1
                                fi
                                echo "API Wrapper version: $VERSION"
                                curl -fsSL "$BASE/${VERSION}/vosp-api-wrappers-java-${VERSION}-dist.zip" -o dist.zip
                                unzip -o dist.zip -d .veracode
                                JAR=$(find .veracode -type f -name "VeracodeJavaAPI*.jar" | head -n1)
                                if [ -z "$JAR" ]; then
                                    echo "ERROR: VeracodeJavaAPI.jar not found"
                                    exit 1
                                fi

                                java -jar "$JAR" \\
                                    -vid "$VERACODE_API_ID" \\
                                    -vkey "$VERACODE_API_KEY" \\
                                    -action UploadAndScan \\
                                    -appname "$APP_NAME" \\
                                    -createprofile true \\
                                    -autoscan true \\
                                    -filepath verascan \\
                                    -version "${BRANCH_NAME}-${BUILD_NUMBER}"
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}
